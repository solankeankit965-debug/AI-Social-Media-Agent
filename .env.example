# Copy this file to .env. The defaults work with Docker Compose.
POSTGRES_DB=social_agent
POSTGRES_USER=social_agent
POSTGRES_PASSWORD=social_agent
DATABASE_URL=postgresql+psycopg://social_agent:social_agent@postgres:5432/social_agent
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# The app uses a deterministic local content generator when this is blank.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

API_BASE_URL=http://api:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000

# OAuth placeholders. Add real values only when implementing each provider.
META_CLIENT_ID=
META_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=http://localhost:8000/api/v1/oauth/callback
TOKEN_ENCRYPTION_KEY=replace-with-a-generated-fernet-key

